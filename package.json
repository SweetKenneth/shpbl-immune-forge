    "start": "node dist/src/mcp-server.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "security",
    "ai-agents",
    "evidence",
    "defense",
    "regression-gate",
    "shpbl"
  ],
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3"
  }
